# Autonomous Drug Repurposing — Environment Variables
# Copy this file to .env and change the passwords before deploying

# PostgreSQL Master Password (used across all services)
POSTGRES_PASSWORD=your_secure_postgres_password

# Neo4j Master Password (must be at least 8 characters)
NEO4J_PASSWORD=your_secure_neo4j_password

# MLflow Admin Password (for model tracking UI)
MLFLOW_ADMIN_PASSWORD=your_secure_mlflow_password

# Airflow Fernet Key (for encrypting connections in the DB)
# Must be a valid 32-byte url-safe base64-encoded string generated via `cryptography.fernet.Fernet.generate_key()`
AIRFLOW__CORE__FERNET_KEY=3gvgzt8fTx7YinB6PjX0cKIozppR96WQg4XRyZxVg3o=

# JWT Secret (frontend/backend auth)
JWT_SECRET=your_secure_jwt_secret
